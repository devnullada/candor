{
  "name": "candor",
  "version": "0.0.31",
  "description": "A backend language designed for AI coders. TypeScript-shaped, compiles to Go.",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "candor": "bun --no-env-file run src/cli.ts",
