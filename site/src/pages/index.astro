---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import { headlineCards } from '../headline';
import { docPages } from '../site';
import numbers from '../../../trial-numbers/numbers.json';
import rooms from '../examples/rooms.candor?raw';
import roomsTest from '../examples/rooms_test.candor?raw';

const headline = numbers.headline;
const cards = headlineCards(numbers);
const stages = headline.stages as { title: string; done: number; planned: number; about?: boolean }[];

// The change trial: medians over every run of a language, from numbers.json.
const change = numbers.change;
const same = numbers.trials.find((t) => t.id === 'same-spec')!;
const go = change.results.byLang.go;
const cd = change.results.byLang.candor;
const k = (n: number) => `${Math.round(n / 1000)}k`;

const changeRows: [string, string, string][] = [
  ['Refactors that kept the shape asked for', `${go.shapePassed}/${go.refactors}`, `${cd.shapePassed}/${cd.refactors}`],
  ['Turns, median', `${go.turns}`, `${cd.turns}`],
  ['Compiler runs, median', `${go.compilerRuns}`, `${cd.compilerRuns}`],
  ['Context at the first edit, median', k(go.contextTokens), k(cd.contextTokens)],
  ['Tokens in all, median', k(go.tokens), k(cd.tokens)],
  ['Cost, all runs', `$${go.dollars.toFixed(2)}`, `$${cd.dollars.toFixed(2)}`],
];

// Green is what the language does today; amber is what the trials are still testing.
const benefits = [
  { title: 'Effects in the signature', text: 'A function marked `uses sql` may use the database and nothing else. Printing from it is a compile error.' },
  { title: 'Errors are values', text: '`Result<T, E>`, `?` to pass one on, and an unused Result is an error. No exceptions.' },
  { title: 'Fakes built in', text: 'In a test every effect is a fake: SQLite and files in memory, a virtual clock, seeded randomness, captured output. No mocking library.' },
  { title: 'Errors that carry their fix', text: '`candor check` reports every error at once, each with a stable code and a help line written for the agent that reads it.' },
  { title: 'One Go binary', text: 'Candor compiles to Go: one native binary, and Go packages through bindings.' },
  { title: 'Cheaper, safer changes', text: 'The aim of all of the above. The numbers below show where it holds so far, and where it doesn\'t.', unproven: true },
];

---

<Base
  title="Candor: a backend language for AI coders"
  description="A backend language designed for AI coders. Every function says openly what it does: its effects are part of its signature. Compiles to Go."
>
      <main>
        <section class="py-12 sm:py-20">
          <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">A backend language for AI coders.</h1>
          <p class="mt-5 max-w-2xl text-lg text-muted">
            Every function says openly what it does: the effects it may perform are part of its signature.
            TypeScript-shaped syntax, Rust's discipline, compiles to Go.
          </p>
          <div class="mt-8">
            <Code code={`fn handle(req: http.Request) -> http.Response uses sql`} lang="rust" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor="dark" />
          </div>
          <p class="mt-3 text-sm text-muted">The compiler ensures that this handler uses nothing but the database.</p>
        </section>

        <section class="border-t border-line py-12">
          <h2 class="text-2xl font-semibold tracking-tight">Why</h2>
          <p class="mt-3 max-w-2xl text-muted">
            An AI coder writes code that people review rather than write, and reads code it didn't write.
            Candor puts what matters where both can see it.
          </p>
          <div class="mt-8 grid min-w-0 gap-4 sm:grid-cols-2 lg:grid-cols-3 [&>*]:min-w-0">
            {benefits.map((b) => (
              <article class:list={['rounded-lg border bg-panel p-5', b.unproven ? 'border-unproven' : 'border-accent']}>
                <p class="flex items-center gap-2 text-xs text-muted">
                  <span class:list={['inline-block size-2 rounded-full', b.unproven ? 'bg-unproven' : 'bg-accent']}></span>
                  {b.unproven ? 'Being measured' : 'In the language'}
                </p>
                <h3 class="mt-2 font-semibold">{b.title}</h3>
                <p class="mt-1 text-sm text-muted">{b.text.split('`').map((part, i) => (i % 2 ? <code class="font-mono text-fg">{part}</code> : part))}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="numbers" class="border-t border-line py-12">
          <h2 class="text-2xl font-semibold tracking-tight">The numbers</h2>
          <p class="mt-3 max-w-2xl text-muted">
            Four numbers, Candor against Go. Today's figures come from earlier trials, and a held-out trial will replace them.
            Figures marked Expected have not been measured.
          </p>

          <div class="mt-8 grid min-w-0 gap-4 sm:grid-cols-2 [&>*]:min-w-0">
            {cards.map((card) => (
              <article class="rounded-lg border border-line bg-panel p-5">
                <h3 class="font-semibold">{card.title}</h3>
                <p class="mt-1 text-sm text-muted">{card.what}</p>
                <table class="mt-4 w-full text-sm">
                  <thead>
                    <tr class="text-muted">
                      <th class="pb-1 pr-3 text-left font-normal"><span class="sr-only">Measured on</span></th>
                      <th class="pb-1 pr-3 text-right font-normal">Go</th>
                      <th class="pb-1 text-right font-normal">Candor</th>
                    </tr>
                  </thead>
                  <tbody>
                    {card.rows.map((r, i) => (
                      <tr class="border-t border-line">
                        <td class="py-2 pr-3 align-top text-muted">
                          {r.expected && <span class="mb-1 block w-fit rounded border border-unproven px-1.5 text-xs text-fg">Expected</span>}
                          {r.label}
                          {r.expected && r.expected !== card.rows[i + 1]?.expected && <span class="mt-1 block text-xs">{r.expected}</span>}
                        </td>
                        <td class:list={['py-2 pr-3 text-right align-top font-mono text-base', r.expected && 'text-muted']}>{r.go}</td>
                        <td class:list={['py-2 text-right align-top font-mono text-base', r.expected && 'text-muted']}>{r.candor}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </article>
            ))}
          </div>

          <h3 class="mt-10 font-semibold">The held-out trial</h3>
          <p class="mt-2 max-w-2xl text-sm text-muted">{headline.how}</p>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-line text-left text-muted">
                  <th class="py-2 pr-4 font-normal">Progress, {headline.updated}</th>
                  <th class="py-2 text-right font-normal">Runs done</th>
                </tr>
              </thead>
              <tbody>
                {stages.map((s) => (
                  <tr class="border-b border-line">
                    <td class="py-2 pr-4">{s.title}</td>
                    <td class="py-2 text-right font-mono">{s.done} of {s.about ? 'about ' : ''}{s.planned}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-3 text-sm text-muted">{headline.later}</p>

          <h3 class="mt-10 font-semibold">Also measured</h3>
          <div class="mt-2 overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-line text-left text-muted">
                  <th class="py-2 pr-4 font-normal">Changing a codebase, Sonnet, Candor {change.candor}</th>
                  <th class="py-2 pr-4 text-right font-normal">Go</th>
                  <th class="py-2 text-right font-normal">Candor</th>
                </tr>
              </thead>
              <tbody>
                {changeRows.map(([what, g, c]) => (
                  <tr class="border-b border-line">
                    <td class="py-2 pr-4">{what}</td>
                    <td class="py-2 pr-4 text-right font-mono">{g}</td>
                    <td class="py-2 text-right font-mono">{c}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <details class="mt-6 text-sm text-muted">
            <summary class="cursor-pointer text-fg">The catches</summary>
            <ul class="mt-3 list-disc space-y-2 pl-5">
              {[...headline.catches, ...change.catches, ...numbers.compare.catches, ...same.catches].map((c) => <li>{c}</li>)}
            </ul>
          </details>
          <p class="mt-4 text-sm text-muted">
            Every request, run and figure: <a class="underline" href="/docs/trials/">Trials</a>.
          </p>
        </section>

        <section class="border-t border-line py-12">
          <h2 class="text-2xl font-semibold tracking-tight">A service and its test</h2>
          <p class="mt-3 max-w-2xl text-muted">JSON over HTTP from SQLite. The test runs against an in-memory database, with no setup.</p>
          <div class="mt-6 grid min-w-0 gap-4 [&>*]:min-w-0">
            <div>
              <p class="mb-2 font-mono text-xs text-muted">rooms.candor</p>
              <Code code={rooms.trim()} lang="rust" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor="dark" />
            </div>
            <div>
              <p class="mb-2 font-mono text-xs text-muted">rooms_test.candor</p>
              <Code code={roomsTest.trim()} lang="rust" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor="dark" />
            </div>
          </div>
        </section>

        <section class="border-t border-line py-12">
          <h2 class="text-2xl font-semibold tracking-tight">Install</h2>
          <p class="mt-3 max-w-2xl text-muted">
            One binary for Windows, macOS and Linux. Programs build with <a class="underline" href="https://go.dev/dl/">Go</a> 1.22+.
          </p>
          <div class="mt-6 grid min-w-0 gap-3 [&>*]:min-w-0">
            <Code code={`curl -fsSL https://raw.githubusercontent.com/devnullada/candor/master/install.sh | sh`} lang="sh" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor="dark" />
            <Code code={`irm https://raw.githubusercontent.com/devnullada/candor/master/install.ps1 | iex`} lang="powershell" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor="dark" />
          </div>
          <p class="mt-4 max-w-2xl text-sm text-muted">
            Your agent won't know Candor from training; the compiler teaches it. <code class="font-mono text-fg">candor guide</code> prints
            the language on one page, <code class="font-mono text-fg">candor doc</code> a type's methods, and every error from
            <code class="font-mono text-fg">candor check</code> carries its fix. In Claude Code:
            <code class="font-mono text-fg">/plugin marketplace add devnullada/candor</code>.
          </p>
          <p class="mt-3 text-sm"><a class="underline hover:text-accent" href="/download/">Binaries and checksums</a></p>
        </section>

        <section class="border-t border-line py-12">
          <h2 class="text-2xl font-semibold tracking-tight">Docs</h2>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2">
            {docPages.map((p) => (
              <li>
                <a class="font-semibold hover:text-accent" href={`/docs/${p.slug}/`}>{p.name}</a>
                <p class="mt-1 text-sm text-muted">{p.what}</p>
              </li>
            ))}
          </ul>
        </section>
      </main>
</Base>
